# Hourly-ish journal mark refresh. Market-hours window only: fires at :30
# past the hour between 13:30 and 19:30 UTC (covers 9:30–16:00 ET plus a
# buffer). Do NOT write this as `13,14,...:*:30` — with the date fields
# missing, systemd reads the numbers as hour:minute:second and fires every
# 60 seconds, which floods the journal with auto-sync commits every minute
# and thrashes the GitHub Pages CDN (seen 2026-10-21).
# Weekdays only: without the day-of-week field it also fired all weekend,
# re-publishing unchanged marks to the live site seven times a day.
[Unit]
Description=Hourly in-market journal price-mark refresh

[Timer]
OnCalendar=Mon..Fri *-*-* 13..19:30:00
RandomizedDelaySec=120
Persistent=false

[Install]
WantedBy=timers.target
