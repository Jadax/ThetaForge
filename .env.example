# ==========================================
# ThetaForge Configuration
# ALL FREE - No paid API keys required
# ==========================================

# --- Interactive Brokers Paper Bridge (the only execution path) ---
IBKR_HOST=127.0.0.1
IBKR_PAPER_PORT=4002
IBKR_BRIDGE_CLIENT_ID=17
# The bridge deliberately supports paper trading only; live accounts are rejected.
PAPER_TRADING_ONLY=true
# Shared secret between the local Bridge and the dashboard. Keep private.
BRIDGE_ACCESS_TOKEN=change_this_to_a_long_random_value
# Where the dashboard reaches the local Bridge.
BRIDGE_URL=http://127.0.0.1:8002

# --- Hosted Advisor API ---
# Shared secret required by every hosted Advisor endpoint. CORS restricts
# browsers only, so without this any client could trigger scans or mutate the
# watchlist, alerts, and notifications. Enter the same value in the dashboard.
ADVISOR_API_TOKEN=change_this_to_a_long_random_value
# Browser dashboard origins permitted to call the hosted Advisor API.
DASHBOARD_ORIGINS=https://jadax.github.io,http://localhost:3000,http://127.0.0.1:3000

# --- Risk limits (used by the recommender's position sizing) ---
MAX_DAILY_LOSS_PCT=15.0
MAX_DRAWDOWN_PCT=50.0
MAX_POSITION_RISK_PCT=2.0
