# ==========================================
# ThetaForge Configuration
# ALL FREE - No paid API keys required
# ==========================================

# Interactive Brokers (Primary data source + execution)
IBKR_HOST=127.0.0.1
IBKR_PAPER_PORT=4002
IBKR_LIVE_PORT=4001
IBKR_CLIENT_ID=1
IBKR_BRIDGE_CLIENT_ID=17
# The bridge deliberately supports paper trading only.
PAPER_TRADING_ONLY=true

# Alpaca Markets (FREE tier for additional data + backup execution)
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Database
POSTGRES_USER=thetaforge
POSTGRES_PASSWORD=securepassword
POSTGRES_DB=thetaforge
DATABASE_URL=postgresql://thetaforge:securepassword@db:5432/thetaforge

# Redis
REDIS_URL=redis://redis:6379/0

# Browser dashboard origins permitted to call the hosted Advisor API.
DASHBOARD_ORIGINS=https://jadax.github.io,http://localhost:3000,http://127.0.0.1:3000

# Reddit API (FREE - for community sentiment)
# Create app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=ThetaForge/1.0

# Trading Settings
TRADING_MODE=paper
LIVE_ACTIVATION_PIN=123456
MAX_DAILY_LOSS_PCT=15.0
MAX_DRAWDOWN_PCT=50.0
MAX_POSITION_RISK_PCT=2.0

# Strategy Defaults
DEFAULT_IV_RANK_THRESHOLD=40
DEFAULT_TARGET_DTE=30
DEFAULT_PROFIT_TARGET_PCT=50
DEFAULT_STOP_LOSS_MULTIPLIER=2.0

# Scanner Settings
SCANNER_WORKERS=10
SCANNER_INTERVAL_SECONDS=1800
MIN_OPEN_INTEREST=100
MIN_VOLUME=50
MIN_NOTIONAL_VALUE=25000
